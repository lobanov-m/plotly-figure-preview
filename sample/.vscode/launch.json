{
  // Used inside the Extension Development Host, which opens this `sample/` folder as its workspace.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: sample_figures.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sample_figures.py",
      // The venv lives at the repo root, one level up from this workspace.
      "python": "${workspaceFolder}/../.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: sample_images.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sample_images.py",
      "python": "${workspaceFolder}/../.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Exercises the container / cross-machine path, where the editor and the interpreter share
      // no filesystem. In the container:
      //   pip install debugpy plotly
      //   python -m debugpy --listen 0.0.0.0:5678 --wait-for-client /app/sample_figures.py
      "name": "Python: Attach (remote or container)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    }
  ]
}
